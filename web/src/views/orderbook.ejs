<h2 class="mb-3">Order Book (Staging)</h2>

<form class="row g-2 mb-3" method="GET" action="/orderbook">
  <div class="col-auto">
    <input type="text" name="ticker" class="form-control" placeholder="Ticker (mis. BBCA)" value="<%= filter.ticker %>" />
  </div>
  <div class="col-auto">
    <input type="date" name="date" class="form-control" value="<%= filter.date %>" />
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-secondary">Filter</button>
  </div>
</form>

<table class="table table-striped table-sm datatable">
  <thead>
    <tr>
      <th>Waktu</th>
      <th>Ticker</th>
      <th>Side</th>
      <th>Level</th>
      <th>Harga (Raw)</th>
      <th>Lot (Raw)</th>
      <th>Freq (Raw)</th>
      <th>Diproses</th>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach(r => { %>
      <tr>
        <td><%= new Date(r.captured_at).toLocaleString('id-ID') %></td>
        <td><%= r.ticker %></td>
        <td><%= r.side %></td>
        <td><%= r.level %></td>
        <td><%= r.price_raw %></td>
        <td><%= r.lot_raw %></td>
        <td><%= r.freq_raw %></td>
        <td><%= r.processed ? 'Ya' : 'Belum' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
