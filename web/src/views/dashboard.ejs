<h2 class="mb-3">Dashboard Staging &amp; ETL</h2>

<% if (flash) { %>
  <div class="alert alert-info"><%= flash %></div>
<% } %>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h6 class="text-muted">Order Book Belum Diproses</h6>
        <h3><%= stats.pendingOrderbook %></h3>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h6 class="text-muted">Broksum Belum Diproses</h6>
        <h3><%= stats.pendingBroksum %></h3>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h6 class="text-muted">Error Capture (7 Hari)</h6>
        <h3><%= stats.errors7d %></h3>
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <h5 class="mb-1">Capture Terakhir</h5>
      <% if (stats.lastCapture) { %>
        <p class="mb-0 text-muted">
          <%= stats.lastCapture.jenis %> (<%= stats.lastCapture.ticker || 'ALL' %>) —
          <strong><%= stats.lastCapture.status %></strong> |
          <%= stats.lastCapture.jumlah_baris %> baris |
          <%= new Date(stats.lastCapture.waktu_mulai).toLocaleString('id-ID') %>
        </p>
      <% } else { %>
        <p class="mb-0 text-muted">Belum ada riwayat capture.</p>
      <% } %>
    </div>
    <form action="/etl/run" method="POST">
      <button type="submit" class="btn btn-primary">Kirim ke DWH (Jalankan ETL)</button>
    </form>
  </div>
</div>
